mutago-report.html
mutago-*.json

# Binaries for programs and plugins
*.exe
*.exe~
*.dll
*.so
*.dylib

# Test binary, build with `go test -c`
*.test

# Output of the go coverage tool, specifically when used with LiteIDE
*.out
# Local TLS Certificates
.certs/

## Build output
bin

## NODE gitignore
# Logs
logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
lerna-debug.log*

# Runtime data
pids
*.pid
*.seed
*.pid.lock
# Dependencies
vendor/
node_modules/
.pnpm-store/

# Optional npm cache directory
.npm

# Optional eslint cache
.eslintcache

# Astro
.astro/

# Environment variables
.env
.env.local
.env.*.local

# IDE
.idea/
.vscode/
*.swp
*.swo

# OS
.DS_Store
Thumbs.db

# tooling debris we do not want to check in
gha-creds-*.json
gha-kubeconfig-*
*,out

# Rumdl - markdown linter cache
.rumdl_cache
# Vale - grammar checker and style lint.
# Synced style packages are disposable, but the hand-written vocabulary is not,
# so keep .vale/styles/config out of the ignore. Git will not descend into an
# ignored directory, hence the step-by-step re-inclusion.
.vale/*
!.vale/styles
.vale/styles/*
!.vale/styles/config
